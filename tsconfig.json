{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "salon-v1",
    "sophia",
    "webitcertif",
    "itecrtif",
    "Chess-kombat",
    "go",
    "snap",
    "aitrainningcourse",
    "meilleurville",
    "glaceenseine",
    "glaceensein",
    "glaceenseine_backup_2026-05-08",
    "Certquestsapp",
    "portofolio",
    "IT-certif",
    "bencium-claude-code-design-skill",
    "agent-skills",
    "Downloads",
    "crepes"
  ]
}
